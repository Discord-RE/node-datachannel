ARG version=bookworm
ARG node_version=24

# Accept build args
ARG gcc_install

FROM node:${node_version}-${version}

RUN echo "deb https://deb.debian.org/debian bookworm-backports main" >> /etc/apt/sources.list && \
    apt update && \
    apt install -y --no-install-recommends \
        build-essential \
        libssl-dev \
        ninja-build \
        ${gcc_install} && \
    apt install -y --no-install-recommends -t bookworm-backports cmake && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/app/
